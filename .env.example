# Optional: required only for real local CABT play.
# Point this at the Kaggle-provided sample_submission directory.
CABT_SAMPLE_SUBMISSION_DIR=/absolute/path/to/sample_submission

# Optional: full human-vs-AI trace capture for private training data.
# Defaults to ../ptcg-kaggle/private/traces from this sibling checkout.
CABT_TRACE_ENABLED=1
CABT_TRACE_DIR=/absolute/path/to/ptcg-kaggle/private/traces
CABT_TRACE_REVIEWER=local-reviewer
# Allowed: gold, silver, bronze, debug, unreliable.
CABT_TRACE_TRUST=silver
CABT_TRACE_CONFIDENCE=4
